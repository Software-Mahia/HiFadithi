# Copy to .env and fill in. Never commit .env.
SECRET_KEY=replace-with-a-long-random-string-at-least-50-characters
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# Database. Leave empty to use local SQLite.
# Local Postgres via docker compose (see docker-compose.yml at the repo root):
#   DATABASE_URL=postgres://postgres@localhost:5432/hifadithi
# Deployed: Supabase Postgres through the SESSION pooler (port 5432), sslmode=require.
DATABASE_URL=

# Supabase Storage, S3-compatible API (Project Settings > Storage > S3 access keys)
USE_SUPABASE_STORAGE=False
SUPABASE_S3_ENDPOINT=https://<project-ref>.supabase.co/storage/v1/s3
SUPABASE_S3_REGION=<region>
SUPABASE_S3_ACCESS_KEY_ID=
SUPABASE_S3_SECRET_ACCESS_KEY=

# Meshy (owner: C). Use the fake engine for everyday development.
ENGINE=fake
# Leave unset to use our demo model in the Supabase samples bucket
# FAKE_ENGINE_GLB_URL=
FAKE_ENGINE_SECONDS=5
MESHY_API_KEY=
# 15 credits while testing; meshy-7.1 (30 credits) for the pilot
MESHY_AI_MODEL=meshy-6-lite
MESHY_WEBHOOK_TOKEN=change-me
MESHY_MONTHLY_CREDIT_LIMIT=300
# Ported (hifadithi MVP): public base URL for media links without Supabase Storage
PUBLIC_BASE_URL=http://127.0.0.1:8000
# Presigned bucket link lifetime for the app
PRESIGN_EXPIRES_SECONDS=3600
# OCR (museum-card scanning)
OCR_LANGUAGES=eng+swa
# Narration / Piper TTS (pip package piper-tts + imageio-ffmpeg)
PIPER_BIN=piper
FFMPEG_BIN=ffmpeg
# Q_SYNC=True runs narration tasks inside the request instead of a qcluster
# worker process (needed on hosts without workers, e.g. Render free plan).
Q_SYNC=False
