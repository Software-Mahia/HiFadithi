# Copy to .env and fill in. Never commit .env.
SECRET_KEY=replace-with-a-long-random-string-at-least-50-characters
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# Supabase Postgres through the SESSION pooler (port 5432). Leave empty to use local SQLite.
DATABASE_URL=

# Supabase Storage, S3-compatible API (Project Settings > Storage > S3 access keys)
USE_SUPABASE_STORAGE=False
SUPABASE_S3_ENDPOINT=https://<project-ref>.supabase.co/storage/v1/s3
SUPABASE_S3_REGION=<region>
SUPABASE_S3_ACCESS_KEY_ID=
SUPABASE_S3_SECRET_ACCESS_KEY=

# Meshy (owner: C). Use the fake engine for everyday development.
ENGINE=fake
MESHY_API_KEY=
MESHY_WEBHOOK_TOKEN=change-me
MESHY_MONTHLY_CREDIT_LIMIT=300
